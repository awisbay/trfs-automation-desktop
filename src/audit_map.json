{
  "gsm_fdn_prefix": "SubNetwork=ONRM_ROOT_MO_R,SubNetwork=T7,SubNetwork=BSC,MeContext={bsc},ManagedElement={bsc},BscFunction=1,BscM=1,GeranCellM=1",
  "_note": "CDD Audit mapping. Each profile maps a CDD sheet to a node MO. 'mo_fdn'/'mo' are templates: {ColumnHeader} is replaced with the row value. 'attr' = the MO attribute name in the modump/cmdump (calibrate against a real dump). node_key_column filters rows to the audited node. Add params/sheets by editing this file — no rebuild.",
  "profiles": [
    {
      "name": "LTE Node (ManagedElement)",
      "tech": "lte_nr",
      "category": "node",
      "sheet": "CDD",
      "header_row": 3,
      "node_key_column": "eNodeBName",
      "mo_fdn": "ManagedElement={eNodeBName}",
      "columns": [
        {
          "cdd": "UserLabel_Node",
          "attr": "userLabel"
        }
      ]
    },
    {
      "name": "LTE Cell (EUtranCellFDD)",
      "tech": "lte_nr",
      "category": "cell",
      "sheet": "CDD",
      "header_row": 3,
      "node_key_column": "eNodeBName",
      "mo_fdn": "ENodeBFunction=1,{_cellmo}={CellName}",
      "cell_mo_map": {
        "band_column": "Freq Band",
        "map": {
          "L26": "EUtranCellTDD",
          "L23": "EUtranCellTDD"
        },
        "default": "EUtranCellFDD"
      },
      "columns": [
        {
          "cdd": "TAC",
          "attr": "tac"
        },
        {
          "cdd": "DLEARFCN",
          "attr": "earfcndl",
          "attr_fallback": "earfcn"
        },
        {
          "cdd": "ULEARFCN",
          "attr": "earfcnul",
          "attr_fallback": "earfcn"
        },
        {
          "cdd": "PCI",
          "attr": "physicalLayerCellId"
        },
        {
          "cdd": "Root Sequence Index",
          "attr": "rachRootSequence"
        },
        {
          "cdd": "CRSGain",
          "attr": "crsGain"
        },
        {
          "cdd": "configuredMaxTxPower",
          "attr": "configuredMaxTxPower",
          "via_ref": "sectorCarrierRef"
        },
        {
          "cdd": "sectorCarrierType",
          "attr": "sectorCarrierType",
          "via_ref": "sectorCarrierRef"
        },
        {
          "cdd": "UserLabel_Cell",
          "attr": "userLabel"
        },
        {
          "cdd": "MIMO",
          "via_ref": "sectorCarrierRef",
          "split": [
            {
              "attr": "noOfTxAntennas",
              "attr_alt": "noOfUsedTxAntennas",
              "regex": "(\\d+)T"
            },
            {
              "attr": "noOfRxAntennas",
              "attr_alt": "noOfUsedRxAntennas",
              "regex": "(\\d+)R"
            }
          ]
        },
        {
          "cdd": "DL BW(Mhz)",
          "attr": "dlChannelBandwidth",
          "attr_fallback": "channelBandwidth",
          "norm": "bw"
        },
        {
          "cdd": "DL BW(Mhz)",
          "attr": "ulChannelBandwidth",
          "attr_fallback": "channelBandwidth",
          "norm": "bw"
        },
        {
          "cdd": "Latitude",
          "attr": "latitude",
          "norm": "geo"
        },
        {
          "cdd": "Longitude",
          "attr": "longitude",
          "norm": "geo"
        }
      ]
    },
