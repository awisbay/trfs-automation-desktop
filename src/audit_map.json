{
  "gsm_fdn_prefix": "SubNetwork=ONRM_ROOT_MO_R,SubNetwork=T7,SubNetwork=BSC,MeContext={bsc},ManagedElement={bsc},BscFunction=1,BscM=1,GeranCellM=1",
  "_note": "CDD Audit mapping. Each profile maps a CDD sheet to a node MO. 'mo_fdn'/'mo' are templates: {ColumnHeader} is replaced with the row value. 'attr' = the MO attribute name in the modump/cmdump (calibrate against a real dump). node_key_column filters rows to the audited node. Add params/sheets by editing this file \u00e2\u20ac\u201d no rebuild.",
  "profiles": [
    {
      "name": "LTE Node (ManagedElement)",
      "tech": "lte_nr",
      "category": "node",
      "sheet": "CDD",
      "header_row": 3,
      "node_key_column": "eNodeBName",
      "mo_fdn": "ManagedElement={eNodeBName}",
      "columns": [
        {
          "cdd": "UserLabel_Node",
          "attr": "userLabel"
        },
        {
          "cdd": "ENodeBID",
          "attr": "eNBId",
          "mo": "ENodeBFunction=1"
        }
      ]
    },
    {
      "name": "LTE Cell (EUtranCellFDD)",
      "tech": "lte_nr",
      "category": "cell",
      "sheet": "CDD",
      "header_row": 3,
      "node_key_column": "eNodeBName",
      "mo_fdn": "ENodeBFunction=1,{_cellmo}={CellName}",
      "cell_mo_map": {
        "band_column": "Freq Band",
        "map": {
          "L26": "EUtranCellTDD",
          "L23": "EUtranCellTDD"
        },
        "default": "EUtranCellFDD"
      },
      "columns": [
        {
          "cdd": "TAC",
          "attr": "tac"
        },
        {
          "cdd": "CellID",
          "attr": "cellId"
        },
        {
          "cdd": "DLEARFCN",
          "attr": "earfcndl",
          "attr_fallback": "earfcn"
        },
        {
          "cdd": "ULEARFCN",
          "attr": "earfcnul",
          "attr_fallback": "earfcn"
        },
        {
          "cdd": "PCI",
          "attr": "physicalLayerCellId"
        },
        {
          "cdd": "Root Sequence Index",
          "attr": "rachRootSequence"
        },
        {
          "cdd": "CRSGain",
          "attr": "crsGain"
        },
        {
          "cdd": "configuredMaxTxPower",
          "attr": "configuredMaxTxPower",
          "via_ref": "sectorCarrierRef"
        },
        {
          "cdd": "sectorCarrierType",
          "attr": "sectorCarrierType",
          "via_ref": "sectorCarrierRef"
        },
        {
          "cdd": "UserLabel_Cell",
          "attr": "userLabel"
        },
        {
          "cdd": "MIMO",
          "via_ref": "sectorCarrierRef",
          "split": [
            {
              "attr": "noOfTxAntennas",
              "attr_alt": "noOfUsedTxAntennas",
              "regex": "(\\d+)T"
            },
            {
              "attr": "noOfRxAntennas",
              "attr_alt": "noOfUsedRxAntennas",
              "regex": "(\\d+)R"
            }
          ]
        },
        {
          "cdd": "DL BW(Mhz)",
          "attr": "dlChannelBandwidth",
          "attr_fallback": "channelBandwidth",
          "norm": "bw"
        },
        {
          "cdd": "DL BW(Mhz)",
          "attr": "ulChannelBandwidth",
          "attr_fallback": "channelBandwidth",
          "norm": "bw"
        },
        {
          "cdd": "Latitude",
          "attr": "latitude",
          "norm": "geo"
        },
        {
          "cdd": "Longitude",
          "attr": "longitude",
          "norm": "geo"
        }
      ]
    },
    {
      "name": "NR Node (ManagedElement)",
      "tech": "nr",
      "category": "node",
      "sheet": "CDD",
      "header_row": 3,
      "node_key_column": "gNodeBName",
      "mo_fdn": "ManagedElement={gNodeBName}",
      "columns": [
        {
          "cdd": "UserLabel_Node",
          "attr": "userLabel"
        },
        {
          "cdd": "gNodeBID",
          "attr": "gNBId",
          "mo": "GNBDUFunction=1"
        }
      ]
    },
    {
      "name": "NR Cell (NRCellDU)",
      "tech": "nr",
      "category": "cell",
      "sheet": "CDD",
      "header_row": 3,
      "node_key_column": "gNodeBName",
      "mo_fdn": "GNBDUFunction=1,NRCellDU={CellName}",
      "columns": [
        {
          "cdd": "nRPCI",
          "attr": "nRPCI"
        },
        {
          "cdd": "TAC",
          "attr": "nRTAC"
        },
        {
          "cdd": "LocalCellID",
          "attr": "cellLocalId"
        },
        {
          "cdd": "UserLabel_Cell",
          "attr": "userLabel"
        },
        {
          "cdd": "Root Sequence Index",
          "attr": "rachRootSequence"
        },
        {
          "cdd": "DLEARFCN",
          "attr": "arfcnDL",
          "via_ref": "nRSectorCarrierRef"
        },
        {
          "cdd": "ULEARFCN",
          "attr": "arfcnUL",
          "via_ref": "nRSectorCarrierRef"
        },
        {
          "cdd": "DL BW(MHz)",
          "attr": "bSChannelBwDL",
          "via_ref": "nRSectorCarrierRef"
        },
        {
          "cdd": "MIMO",
          "via_ref": "nRSectorCarrierRef",
          "split": [
            {
              "attr": "noOfTxAntennas",
              "attr_alt": "noOfUsedTxAntennas",
              "regex": "(\\d+)T"
            },
            {
              "attr": "noOfRxAntennas",
              "attr_alt": "noOfUsedRxAntennas",
              "regex": "(\\d+)R"
            }
          ]
        },
        {
          "cdd": "Latitude",
          "attr": "latitude",
          "via_ref": "nRSectorCarrierRef",
          "norm": "geo"
        },
        {
          "cdd": "Longitude",
          "attr": "longitude",
          "via_ref": "nRSectorCarrierRef",
          "norm": "geo"
        }
      ]
    },
    {
      "name": "GSM Cell (BSC \u00e2\u20ac\u201d via live cmedit, not dump)",
      "tech": "gsm",
      "category": "cell",
      "source": "cmedit",
      "cmedit_scope": "*BS*",
      "cmedit_mo": "GeranCell",
      "cmedit_cmd": "cmedit get {scope} {mo}.(gerancellid=={site_mod}*,{attrs}) -t",
      "sheet": "GSM",
      "header_row": 4,
      "node_key_column": "gsmNodeName",
      "mo_fdn": "GeranCell={geranCellId}",
      "columns": [
        {
          "cdd": "NEW CGI",
          "attr": "cgi",
          "norm": "segments"
        },
        {
          "cdd": "NCC",
          "attr": "ncc"
        },
        {
          "cdd": "BCC",
          "attr": "bcc"
        },
        {
          "cdd": "BCCHNO",
          "attr": "bcchNo"
        },
        {
          "cdd": "USER LABEL_CELL",
          "attr": "userLabel"
        },
        {
          "cdd": "NEW RAC",
          "attr": "rac"
        },
        {
          "cdd": "CSYSTYPE",
          "attr": "cSysType"
        }
      ]
    },
    {
      "name": "GSM PhysicalData (BSC cmedit)",
      "tech": "gsm",
      "category": "cell",
      "source": "cmedit",
      "cmedit_scope": "*BS*",
      "cmedit_mo": "PhysicalData",
      "cmedit_cmd": "cmedit get {scope} GeranCell.gerancellid=={site_mod}*,{mo}.({attrs}) -t",
      "key_fdn": "GeranCell={GeranCellId}",
      "sheet": "GSM",
      "header_row": 4,
      "node_key_column": "gsmNodeName",
      "mo_fdn": "GeranCell={geranCellId}",
      "columns": [
        {
          "cdd": "Latitude_DMS",
          "attr": "latitude",
          "norm": "latlong"
        },
        {
          "cdd": "Longitude_DMS",
          "attr": "longitude",
          "norm": "latlong"
        }
      ]
    },
    {
      "name": "GSM Trx arfcn (RadioNode)",
      "tech": "gsm",
      "category": "cell",
      "cmedit_mo": "Trx",
      "cmedit_cmd": "cmedit get {site_id}* Trx.({attrs}) -t",
      "key_fdn": "GsmSector={GsmSectorId}",
      "sheet": "GSM",
      "header_row": 4,
      "node_key_column": "gsmNodeName",
      "mo_fdn": "GsmSector={CELLNAME}",
      "columns": [
        {
          "cdd": "arfcnMin",
          "attr": "arfcnMin"
        },
        {
          "cdd": "arfcnMax",
          "attr": "arfcnMax"
        },
        {
          "cdd": "No of UL TRX",
          "attr": "__count__"
        },
        {
          "cdd": "CELLNAME",
          "attr": "gsmSectorId"
        }
      ]
    },
    {
      "name": "GSM Node userLabel (RadioNode)",
      "tech": "gsm",
      "category": "node",
      "sheet": "GSM",
      "header_row": 4,
      "node_key_column": "gsmNodeName",
      "mo_fdn": "ManagedElement={gsmNodeName}",
      "columns": [
        {
          "cdd": "UserLabel_Node",
          "attr": "userLabel"
        }
      ]
    },
    {
      "name": "GSM BSC IP Broker (config.json bsc_broker_map)",
      "_note": "Expected broker IP is NOT a CDD column: the CDD BSC column names the node's BSC, and config.json bsc_broker_map maps that BSC to its broker IP. The node's actual AbisIp.bscBrokerIpAddress (dump) is compared to it by broker_check(). __bscbroker__ marks these rows so audit_page routes them to that check.",
      "tech": "gsm",
      "category": "node",
      "sheet": "GSM",
      "header_row": 4,
      "node_key_column": "gsmNodeName",
      "mo_fdn": "AbisIp=1",
      "columns": [
        {
          "cdd": "BSC",
          "attr": "__bscbroker__"
        }
      ]
    }
  ],
